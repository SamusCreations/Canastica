# Copia este archivo a .env y completa los valores (nunca subas .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clave pública VAPID para notificaciones push (la privada va solo en los secretos de Supabase)
VITE_VAPID_PUBLIC_KEY=
# Dominio que recibe las facturas por correo (facturas+<código>@dominio). Vacío = función oculta
VITE_INBOUND_DOMAIN=
